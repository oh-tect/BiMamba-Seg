        (layers): ModuleList(
          (0-1): 2 x AggregatorLayer(
            (eff_agg): EffAggregatorLayer(
              (spatial_fusion): SptialFusionBlock(
                (sa): VisionMambaBlock(
                  (norm1): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                  (mamba): VisionMambaMixer(
                    (film_modulator): VisualModulator(
                      (text_proj): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
                        (1): GELU(approximate='none')
                        (2): Linear(in_features=128, out_features=256, bias=True)
                      )
                      (class_freq_pref): Linear(in_features=128, out_features=1, bias=True)
                      (text_mask_proj): Identity()
                    )
                    (guidance_gate): Conv2d(256, 1, kernel_size=(1, 1), stride=(1, 1))
                    (pre_norm): LayerNorm2d(
                      (norm): LayerNorm((256,), eps=1e-06, elementwise_affine=True)
                    )
                    (pre_proj): Conv2d(256, 256, kernel_size=(1, 1), stride=(1, 1))
                    (pre_dwconv): Conv2d(256, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), groups=256)
                    (in_proj): Conv2d(256, 256, kernel_size=(1, 1), stride=(1, 1))
                    (seq_row): RowRecurrentScanner(
                      (out_norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                      (gate): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
                        (1): SiLU()
                      )
                      (proj_in): Linear(in_features=128, out_features=384, bias=True)
                      (drop): Dropout(p=0.0, inplace=False)
                    )
                    (seq_col): RowRecurrentScanner(
                      (out_norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                      (gate): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
                        (1): SiLU()
                      )
                      (proj_in): Linear(in_features=128, out_features=384, bias=True)
                      (drop): Dropout(p=0.0, inplace=False)
                    )
                    (out_norm): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                    (out_proj): Conv2d(128, 128, kernel_size=(1, 1), stride=(1, 1))
                    (drop): Dropout(p=0.0, inplace=False)
                  )
                  (norm2): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                  (mlp): Sequential(
                    (0): Conv2d(128, 384, kernel_size=(1, 1), stride=(1, 1))
                    (1): GELU(approximate='none')
                    (2): Conv2d(384, 128, kernel_size=(1, 1), stride=(1, 1))
                    (3): Dropout(p=0.0, inplace=False)
                  )
                  (drop_path): Identity()
                )
              )
              (class_fusion): ClassFusionBlock(
                (sa): MiTBlock(
                  (norm1): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                  (attention): Attention(
                    (q): Linear(in_features=256, out_features=128, bias=True)
                    (k): Linear(in_features=256, out_features=128, bias=True)
                    (v): Linear(in_features=128, out_features=128, bias=True)
                    (proj): Linear(in_features=128, out_features=128, bias=True)
                    (proj_drop): Dropout(p=0.0, inplace=False)
                  )
                  (norm2): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                  (mlp): Mlp(
                    (fc1): Linear(in_features=128, out_features=384, bias=True)
                    (fc2): Linear(in_features=128, out_features=384, bias=True)
                    (act): ReLU6(inplace=True)
                    (fc3): Linear(in_features=384, out_features=128, bias=True)
                    (drop): Dropout(p=0.0, inplace=False)
                  )
                  (drop_path): Identity()
                )
                (pool): AvgPool2d(kernel_size=(2, 2), stride=(2, 2), padding=0)
                (TextModulator): TextModulator(
                  (vis_proj): Sequential(
                    (0): LayerNorm((768,), eps=1e-05, elementwise_affine=True)
                    (1): Linear(in_features=768, out_features=128, bias=False)
                  )
                )
              )
            )
          )
        )
        (conv1): Conv2d(1, 128, kernel_size=(7, 7), stride=(1, 1), padding=(3, 3))
        (guidance_projection): Sequential(
          (0): Conv2d(512, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
          (1): ReLU()
        )
        (text_guidance_projection): Sequential(
          (0): Linear(in_features=512, out_features=128, bias=True)
          (1): ReLU()
        )
        (decoder_guidance_projection): ModuleList(
          (0): Sequential(
            (0): Conv2d(256, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
            (1): ReLU()
          )
          (1): Sequential(
            (0): Conv2d(128, 16, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
            (1): ReLU()
          )
        )
        (decoder1): Up(
          (up): ConvTranspose2d(128, 96, kernel_size=(2, 2), stride=(2, 2))
          (conv): DoubleConv(
            (double_conv): Sequential(
              (0): Conv2d(128, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)
              (1): GroupNorm(4, 64, eps=1e-05, affine=True)
              (2): ReLU(inplace=True)
              (3): Conv2d(64, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)
              (4): GroupNorm(4, 64, eps=1e-05, affine=True)
              (5): ReLU(inplace=True)
            )
          )
        )
        (decoder2): Up(
          (up): ConvTranspose2d(64, 48, kernel_size=(2, 2), stride=(2, 2))
          (conv): DoubleConv(
            (double_conv): Sequential(
              (0): Conv2d(64, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)
              (1): GroupNorm(2, 32, eps=1e-05, affine=True)
              (2): ReLU(inplace=True)
              (3): Conv2d(32, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), bias=False)
              (4): GroupNorm(2, 32, eps=1e-05, affine=True)
              (5): ReLU(inplace=True)
            )
          )
        )
        (head): Conv2d(32, 1, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
      )
      (image_vpn): ImageVpnGenerator(
        (cross_attn): CrossAttention(
          (fc_q): Linear(in_features=512, out_features=512, bias=True)
          (fc_k): Linear(in_features=512, out_features=512, bias=True)
          (fc_v): Linear(in_features=512, out_features=512, bias=True)
          (softmax): Softmax(dim=-1)
        )
        (fc_mean): Linear(in_features=512, out_features=512, bias=True)
        (fc_variance): Linear(in_features=512, out_features=512, bias=True)
      )
      (text_vpn): TextVpnGenerator()
    )
  )
  (upsample1): ConvTranspose2d(768, 256, kernel_size=(2, 2), stride=(2, 2))
  (upsample2): ConvTranspose2d(768, 128, kernel_size=(4, 4), stride=(4, 4))
)
