        )
        (token_embedding): Embedding(49408, 512)
        (ln_final): LayerNorm((512,), eps=1e-05, elementwise_affine=True)
      )
      (transformer): Aggregator(
        (layers): ModuleList(
          (0-1): 2 x AggregatorLayer(
            (eff_agg): EffAggregatorLayer(
              (spatial_fusion): SptialFusionBlock(
                (sa): VisionMambaBlock(
                  (norm1): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                  (mamba): VisionMambaMixer(
                    (film_modulator): VisualModulator(
                      (text_proj): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
                        (1): GELU(approximate='none')
                        (2): Linear(in_features=128, out_features=256, bias=True)
                      )
                      (class_freq_pref): Linear(in_features=128, out_features=1, bias=True)
                      (text_mask_proj): Identity()
                    )
                    (guidance_gate): Conv2d(256, 1, kernel_size=(1, 1), stride=(1, 1))
                    (pre_norm): LayerNorm2d(
                      (norm): LayerNorm((256,), eps=1e-06, elementwise_affine=True)
                    )
                    (pre_proj): Conv2d(256, 256, kernel_size=(1, 1), stride=(1, 1))
                    (pre_dwconv): Conv2d(256, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1), groups=256)
                    (in_proj): Conv2d(256, 256, kernel_size=(1, 1), stride=(1, 1))
                    (seq_row): RowRecurrentScanner(
                      (out_norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                      (gate): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
