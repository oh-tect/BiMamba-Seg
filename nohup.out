                    )
                    (seq_col): RowRecurrentScanner(
                      (out_norm): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                      (gate): Sequential(
                        (0): Linear(in_features=128, out_features=128, bias=True)
                        (1): SiLU()
                      )
                      (proj_in): Linear(in_features=128, out_features=384, bias=True)
                      (drop): Dropout(p=0.0, inplace=False)
                    )
                    (out_norm): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                    (out_proj): Conv2d(128, 128, kernel_size=(1, 1), stride=(1, 1))
                    (drop): Dropout(p=0.0, inplace=False)
                  )
                  (norm2): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
                  (mlp): Sequential(
                    (0): Conv2d(128, 384, kernel_size=(1, 1), stride=(1, 1))
                    (1): GELU(approximate='none')
                    (2): Conv2d(384, 128, kernel_size=(1, 1), stride=(1, 1))
                    (3): Dropout(p=0.0, inplace=False)
                  )
                  (drop_path): Identity()
                )
              )
              (class_fusion): ClassFusionBlock(
                (sa): MiTBlock(
                  (norm1): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                  (attention): Attention(
                    (q): Linear(in_features=256, out_features=128, bias=True)
                    (k): Linear(in_features=256, out_features=128, bias=True)
                    (v): Linear(in_features=128, out_features=128, bias=True)
                    (proj): Linear(in_features=128, out_features=128, bias=True)
                    (proj_drop): Dropout(p=0.0, inplace=False)
                  )
                  (norm2): LayerNorm((128,), eps=1e-05, elementwise_affine=True)
                  (mlp): Mlp(
                    (fc1): Linear(in_features=128, out_features=384, bias=True)
                    (fc2): Linear(in_features=128, out_features=384, bias=True)
                    (act): ReLU6(inplace=True)
                    (fc3): Linear(in_features=384, out_features=128, bias=True)
                    (drop): Dropout(p=0.0, inplace=False)
                  )
                  (drop_path): Identity()
                )
                (pool): AvgPool2d(kernel_size=(2, 2), stride=(2, 2), padding=0)
                (TextModulator): TextModulator(
                  (vis_proj): Sequential(
                    (0): LayerNorm((768,), eps=1e-05, elementwise_affine=True)
                    (1): Linear(in_features=768, out_features=128, bias=False)
                  )
                )
              )
            )
          )
        )
        (conv1): Conv2d(1, 128, kernel_size=(7, 7), stride=(1, 1), padding=(3, 3))
        (guidance_projection): Sequential(
          (0): Conv2d(512, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
          (1): ReLU()
        )
        (text_guidance_projection): Sequential(
          (0): Linear(in_features=512, out_features=128, bias=True)
          (1): ReLU()
        )
        (decoder_guidance_projection): ModuleList(
          (0): Sequential(
            (0): Conv2d(256, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
